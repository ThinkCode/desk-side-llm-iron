# Amazon Product Advertising API v5 credentials
# Copy to .env and fill in.  NEVER commit .env.
#
# Keys: https://affiliate-program.amazon.com/assoc_credentials/home
# Requires 3 qualifying sales in the last 180 days for API access.

PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=amznbargain-20

# Marketplace (defaults shown are US)
PAAPI_HOST=webservices.amazon.com
PAAPI_REGION=us-east-1
PAAPI_MARKETPLACE=www.amazon.com
